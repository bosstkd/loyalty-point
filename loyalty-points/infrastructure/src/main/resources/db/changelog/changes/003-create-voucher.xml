<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="003-create-voucher" author="loyalty-points">
        <createTable tableName="voucher">
            <column name="id" type="VARCHAR(255)">
                <constraints primaryKey="true" primaryKeyName="pk_voucher" nullable="false"/>
            </column>
            <column name="customer_id" type="VARCHAR(255)"/>
            <column name="points_value" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="issued_at" type="DATE"/>
            <column name="expires_at" type="DATE"/>
            <column name="status" type="VARCHAR(255)"/>
        </createTable>

        <createIndex tableName="voucher" indexName="idx_voucher_customer_id">
            <column name="customer_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
