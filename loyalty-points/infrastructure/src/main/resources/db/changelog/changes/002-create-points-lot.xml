<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-create-points-lot" author="loyalty-points">
        <createTable tableName="points_lot">
            <column name="id" type="VARCHAR(255)">
                <constraints primaryKey="true" primaryKeyName="pk_points_lot" nullable="false"/>
            </column>
            <column name="account_customer_id" type="VARCHAR(255)">
                <constraints nullable="false"
                             foreignKeyName="fk_points_lot_loyalty_account"
                             references="loyalty_account(customer_id)"/>
            </column>
            <column name="remaining" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="earned_at" type="DATE"/>
            <column name="expires_at" type="DATE"/>
        </createTable>

        <createIndex tableName="points_lot" indexName="idx_points_lot_account_customer_id">
            <column name="account_customer_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
